   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Not one of the twelve tools exists as a webhook. Both assistants show tools: none — so today the agent says it opened a ticket and nothing is written.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Not one of the twelve tools exists as a webhook. Both assistants show tools: none — so today the agent says it opened a ticket and nothing is written.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
