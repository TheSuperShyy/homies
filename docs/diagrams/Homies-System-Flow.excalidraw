   "versionNonce": 38530817,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Voice: warm transfer, the agent whispers a summary first. No rep free → schedule_callback and say so.    WhatsApp: staff take the thread, the bot switches off for it.",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Voice: warm transfer, the agent whispers a summary first. No rep free → schedule_callback and say so.    WhatsApp: staff take the thread, the bot switches off for it.",
   "lineHeight": 1.25,
   "baseline": 11
  },
  {
   "id": "el367",
   "type": "text",
   "x": 104.0,
   "y": 1761.0,
   "width": 1036.0,
   "height": 15.0,
   "angle": 0,
   "strokeColor": "#868e96",
