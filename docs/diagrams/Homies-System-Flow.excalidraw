   "text": "Triggers:  asks for a person  ·  anger or distress  ·  a payment dispute  ·  safety or legal  ·  the agent cannot resolve it",
   "fontSize": 13,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Triggers:  asks for a person  ·  anger or distress  ·  a payment dispute  ·  safety or legal  ·  the agent cannot resolve it",
