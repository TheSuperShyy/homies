   "seed": 3006276,
   "version": 1,
   "versionNonce": 38635546,
   "isDeleted": false,
   "boundElements": null,
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Every dashed pill above lands here. On outbound the agent says the handover line, calls transfer_to_human, and stays on the line — it never hangs up on a handover.",
   "fontSize": 12,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Every dashed pill above lands here. On outbound the agent says the handover line, calls transfer_to_human, and stays on the line — it never hangs up on a handover.",
   "lineHeight": 1.25,
   "baseline": 10
  },
  {
   "id": "el368",
