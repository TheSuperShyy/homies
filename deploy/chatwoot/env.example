# Homies — Chatwoot. Copy to .env ON THE SERVER and fill in. Never commit .env.
#
# Generate the three secrets on the VPS, not here and not in a chat window:
#   openssl rand -hex 64      -> SECRET_KEY_BASE
#   openssl rand -hex 32      -> POSTGRES_PASSWORD
#   openssl rand -hex 32      -> REDIS_PASSWORD   (also paste into REDIS_URL)

# The hostname. No DNS work needed: *.srv1879140.hstgr.cloud is a wildcard and
# every name under it already resolves to 186.240.147.235, so Let's Encrypt's
# HTTP-01 challenge succeeds without owning the zone.
#
# The certresolver is hardcoded to `letsencrypt` in the compose file — that is
# the name Traefik on this box was started with, copied from n8n's own labels
# rather than guessed.
CHATWOOT_HOST=chat.srv1879140.hstgr.cloud

# --- Chatwoot ---------------------------------------------------------------
# Rails signs every session and password-reset token with this. Changing it
# later logs every agent out and voids pending invitations.
SECRET_KEY_BASE=

# Must match the public URL exactly, scheme included, and match CHATWOOT_HOST.
# Chatwoot builds callback URLs and email links from it — wrong and OAuth
# loops, invitations point at localhost, and the WhatsApp channel cannot be
# created.
FRONTEND_URL=https://chat.srv1879140.hstgr.cloud
DEFAULT_LOCALE=en
FORCE_SSL=true

RAILS_ENV=production
NODE_ENV=production
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
LOG_LEVEL=info

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=chatwoot
POSTGRES_USERNAME=chatwoot
POSTGRES_PASSWORD=

REDIS_PASSWORD=
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@redis:6379

# Attachments and avatars on disk. The `storage` volume is what to back up.
ACTIVE_STORAGE_SERVICE=local

# No public signup. ~19 staff, all invited by an admin; an open registration
# form on a public URL collects strangers.
ENABLE_ACCOUNT_SIGNUP=false

# Outbound email. Without it Chatwoot runs, but nobody can be invited and
# nobody can reset a password — discovered on the day someone is locked out.
MAILER_SENDER_EMAIL=Homies <noreply@homies.co.il>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
