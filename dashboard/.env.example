# The two variables the dashboard needs. Copy to .env.local for local work, and
# set both in Vercel under Project Settings -> Environment Variables.
#
# Both are NEXT_PUBLIC_, which means both are compiled into the browser bundle
# and are readable by anyone who opens the site. That is correct here and only
# because of it: the anon key is public by design, and every table it can reach
# is gated by the row-level security policies in supabase/009_dashboard_access.sql.
# Staff sign in with Supabase Auth and read through their own session.
#
# The service role key bypasses RLS entirely. It must NEVER appear in this file,
# in Vercel, or anywhere a NEXT_PUBLIC_ prefix could reach. It belongs to the
# Edge Function and n8n, which run server-side.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
