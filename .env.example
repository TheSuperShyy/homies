# Copy to .env and fill in. .env is gitignored and must stay that way.
# Nothing in this file is ever a real value.
# Full account/credential inventory: docs/reference/Homies-Credentials-Checklist.md

# --- Vapi -------------------------------------------------------------------
# Private (server) key — from dashboard.vapi.ai > Organization > API Keys.
# The key used during design is compromised and must be rotated before use.
VAPI_PRIVATE_KEY=
# Homies — Inbound Intake (demo). NOT f5c758d8-…, which is the English
# collections test and a different assistant.
VAPI_ASSISTANT_ID=a594a4ce-ca47-4cab-8704-160afce199a7

# --- Supabase ---------------------------------------------------------------
# Project not created yet. Service role key is server-side only, never shipped
# to a browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Shared secret between Vapi and the debt-tools Edge Function. Generate with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Set it in two places or nothing works: here, and
#   supabase secrets set TOOL_SECRET=...
# vapi_sync.py attaches no tools at all while this is empty, on purpose — an
# agent pointed at a 404 says it opened a ticket and writes nothing.
TOOL_SECRET=

# --- OXS --------------------------------------------------------------------
# One key per module; a key that reads debts cannot write a service request.
# Created in OXS under Company Settings > API Keys, shown once at creation and
# never again. Rate limits are 60/min and 1,000/hour across all keys.
# Never paste these into chat, code, or git.
OXS_KEY_REQUESTS=
OXS_KEY_DEBTS=
OXS_KEY_GENERAL=

# --- Telephony (Phase 3, not needed for the week-3 demo) --------------------
# Provider undecided — generic BYO SIP trunk into Vapi. Gateway must be an IP
# (Vapi returns 400 on FQDNs); number in E.164. If the number ends up in a
# Twilio-style account instead, replace this block with SID + auth token.
SIP_PHONE_NUMBER=
SIP_GATEWAY_IP=
SIP_USERNAME=
SIP_PASSWORD=

# --- WhatsApp Cloud API (Phase 4) -------------------------------------------
# Permanent system-user token, not the 24h temp token from the app dashboard.
# Number provided by Homies; must never have been registered on the WhatsApp app.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Self-chosen secret, must match the value entered in the Meta app's webhook config.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- OpenRouter (chatbot brain in n8n; voice LLM is billed through Vapi) ----
OPENROUTER_API_KEY=

# --- Google Sheets (nightly OXS export bridge, Phase 5) ---------------------
# Path to the service-account JSON key. Share the export sheet with the
# service account's email or reads fail as 403.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
OXS_EXPORT_SHEET_ID=

# --- Monday (Phase 5) -------------------------------------------------------
# Client-provided — PRD §16 open items #7/#9 (token + which board).
MONDAY_API_TOKEN=
MONDAY_BOARD_ID=

# --- n8n --------------------------------------------------------------------
# Public base URL of the n8n instance Vapi will call for tools.
N8N_BASE_URL=
N8N_WEBHOOK_SECRET=
# Settings > n8n API > Create an API key. This is NOT the webhook URL:
# the key manages workflows, the webhook is what the agent calls.
N8N_API_KEY=
